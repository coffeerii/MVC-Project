@model ContactModel
@{
    ViewData["Title"] = $"Contact - {ViewData["FullName"]}";
    string Url(string s) => s.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? s : "https://" + s;
}
<section class="section">
    <div class="container two-col contact">
        <div>
            <h2>Get in touch</h2>
            <p class="lead">@Model.Text</p>
            <ul class="contact-list">
                <li>
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg></span>
                    <div><strong>Email</strong><a href="mailto:@Model.Email">@Model.Email</a></div>
                </li>
                <li>
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg></span>
                    <div><strong>GitHub</strong><a href="@Url(Model.GitHub)" target="_blank" rel="noopener">@Model.GitHub</a></div>
                </li>
                <li>
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" /></svg></span>
                    <div><strong>LinkedIn</strong><a href="@Url(Model.LinkedIn)" target="_blank" rel="noopener">@Model.LinkedIn</a></div>
                </li>
                <li>
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg></span>
                    <div><strong>Phone number</strong><a href="tel:@Model.Phone.Replace(" ", "")">@Model.Phone</a></div>
                </li>
            </ul>
        </div>
        @await Html.PartialAsync("_Photo", new PhotoModel(Model.Image, "photo contact-photo", "Contact"))
    </div>
</section>
